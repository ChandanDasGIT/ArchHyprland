# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# User specific environment
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
    PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
    for rc in ~/.bashrc.d/*; do
        if [ -f "$rc" ]; then
            . "$rc"
        fi
    done
fi
unset rc

. "$HOME/.local/share/../bin/env"
export PATH="$HOME/.local/bin:$PATH"

# ─────────────────────────────────────────────
# Search function
# ─────────────────────────────────────────────
alias f=fastfetch

# ─────────────────────────────────────────────
# Monitor input
# ─────────────────────────────────────────────

switch-hdmi() {
    ddcutil setvcp 60 17
}

alias change-monitor='switch-hdmi'
alias switch-display='switch-hdmi'
alias change-display='switch-hdmi'
alias change-monitor-15='switch-hdmi'
alias change-display-15='switch-hdmi'
alias change-monitor-hdmi='switch-hdmi'
alias change-display-hdmi='switch-hdmi'
alias hdmi='switch-hdmi'

switch-dp() {
    ddcutil setvcp 60 15
}

alias dp='switch-dp'

# ─────────────────────────────────────────────
# DNF (Fedora Package Manager)
# ─────────────────────────────────────────────

alias install='echo '9988' | sudo -S true && sudo dnf install -y'
alias update='echo '9988' | sudo -S true && sudo dnf upgrade --refresh -y'
alias uninstall='echo '9988' | sudo -S true && sudo dnf remove -y'

alias cgpt='carbonyl https://chatgpt.com/'

# ─────────────────────────────────────────────
# Config file shortcuts
# ─────────────────────────────────────────────

_config_file() {
    case "$1" in
        hyprland-lua) echo "$HOME/.config/hypr/hyprland.lua" ;;
        hl) echo "$HOME/.config/hypr/hyprland.lua" ;;
        waybar-conf)  echo "$HOME/.config/waybar/config" ;;
        waybar-css)   echo "$HOME/.config/waybar/style.css" ;;
        docker-css)   echo "$HOME/.config/nwg-dock-hyprland/style.css" ;;
        drawer-css)   echo "$HOME/.config/nwg-drawer/drawer.css" ;;
        drc)   echo "$HOME/.config/nwg-drawer/drawer.css" ;;
        bashrc|script) echo "$HOME/.config/bash/bashrc" ;;
        *)             echo "$1" ;;
    esac
}

# Open with nano
nano() {
    local target
    target="$(_config_file "$1")"
    command nano "$target"
}

# Open with Kate
kate() {
    local target
    target="$(_config_file "$1")"
    command kate "$target" &>/dev/null &
}

# Open with Code
code() {
    local target
    target="$(_config_file "$1")"
    command code "$target" &>/dev/null &
}

# ─────────────────────────────────────────────
# Search function
# ─────────────────────────────────────────────

search() {
    if [[ -z "$1" ]]; then
        echo "Usage: search <name>"
        return 1
    fi

    find "$HOME" -iname "*$1*" 2>/dev/null
}
